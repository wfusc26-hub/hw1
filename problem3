#!/usr/bin/env python3
"""Group words that are anagrams of each other."""

from __future__ import annotations

import json
import sys
from collections import defaultdict


def group_anagrams(words: list[str]) -> list[list[str]]:
    """Return groups of words that are anagrams.

    Words are grouped by their sorted-character signature.
    """
    groups: dict[str, list[str]] = defaultdict(list)
    for word in words:
        signature = "".join(sorted(word))
        groups[signature].append(word)
    return list(groups.values())


def main() -> None:
    """CLI entrypoint: pass words as arguments."""
    words = sys.argv[1:]
    if not words:
        raise SystemExit("Usage: ./problem3 <word1> <word2> ...")

    print(json.dumps(group_anagrams(words)))


if __name__ == "__main__":
    main()
